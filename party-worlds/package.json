{
  "name": "party-worlds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "server": "tsx server/main.ts",
    "size": "node scripts/check-size.mjs",
    "check": "tsc --noEmit && vitest run && tsx dev/fingerprint.ts && vite build && node scripts/check-size.mjs",
    "smoke": "node dev/smoke.mjs",
    "fingerprint": "tsx dev/fingerprint.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "playwright-core": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "ws": "^8.22.2"
  },
  "engines": {
    "node": ">=20"
  }
}
